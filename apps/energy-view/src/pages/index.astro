---
import "../styles/material.css";

const liveStats = ["FVE today", "FVE tomorrow", "Heater now", "Tank", "Price now"];
const dayStats = [
  "EUR rate",
  "Grid purchase",
  "Export",
  "Sun saved",
  "Day balance",
  "Bought cheaply",
  "Sold expensively",
  "Battery stayed safe",
  "Morning export was wise",
  "Import price",
  "Day median",
  "Minutes under 20%",
  "Lowest charge",
  "Tank on the cheap half"
];
const apiBase = import.meta.env.PUBLIC_ENERGY_API_BASE;
if (!apiBase)
  throw new Error("Missing PUBLIC_ENERGY_API_BASE");
const dayCharts = [
  "Spot price",
  "Grid",
  "Sun",
  "Tank plan",
  "Tank heating",
  "Car plan",
  "Car charging",
  "Battery plan",
  "Battery power",
  "House battery",
  "Sun covers the house",
  "Tank temperature"
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Halamaci automation</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <h1>Halamaci automation</h1>
    </header>
    <main>
      <section class="card">
        <h2>Connection</h2>
        <form id="connection">
          <label>API address
            <input id="api-base" name="apiBase" value={apiBase} autocomplete="url" />
          </label>
          <label>API key
            <input id="api-key" name="apiKey" type="password" autocomplete="off" />
          </label>
          <label>Day
            <input id="day" name="day" type="date" />
          </label>
          <button id="prev-day" type="button" class="quiet">Previous</button>
          <button id="today" type="button" class="quiet">Today</button>
          <button id="next-day" type="button" class="quiet">Next</button>
          <button type="submit">Load</button>
        </form>
        <p id="status" class="status" role="status"></p>
      </section>

      <section class="card">
        <h2>House now</h2>
        <p class="note">These are measurements. The day below is one clock: what drove the plan, then each plan beside what happened.</p>
        <div id="live" class="stats">
          {liveStats.map((label) => <div class="stat"><span>{label}</span><strong class="pending">—</strong></div>)}
        </div>
        <button id="recalculate-plan" type="button">Recalculate plan</button>
        <p id="plan-note" class="note"></p>
      </section>

      <section class="card">
        <h2>This day</h2>
        <p class="note">Import, export, and the balance use that day's ČNB euro rate. Import also pays 1.5 Kč/kWh distribution. Sun saved is the solar energy that stayed in the house, valued at that same import price.</p>
        <div id="scores" class="stats">
          {dayStats.map((label) => <div class="stat"><span>{label}</span><strong class="pending">—</strong></div>)}
        </div>
        <p id="forecast-deviation" class="note"></p>
      </section>

      <section class="card">
        <h2>Day balance</h2>
        <p class="note">The last 30 days. Above zero is the import: house, battery charge, car, and tank. Export hangs below zero.</p>
        <div class="chart-wrap" role="img" aria-label="Day balance chart"><canvas id="balance-history"></canvas></div>
      </section>

      <section class="card">
        <h2>House reserve</h2>
        <p class="note">The line that used to sit at 50%. The night always stays above the 20% outage floor. That morning's sun is taken off the daylight only. A day with too few quiet nights uses the seasonal tables.</p>
        <div class="chart-wrap" role="img" aria-label="House reserve chart"><canvas id="reserve-history"></canvas></div>
      </section>

      <section class="card">
        <h2>The plan</h2>
        <p id="day-label" class="note"></p>
        <p id="plan-line" class="note"></p>
        <div id="plan-bar" class="plan-bar"></div>
        <ul id="plan-changes" class="plan-changes"></ul>
        <div id="plan-snapshot" class="plan-snapshot" hidden></div>
        <h2 class="follows">Where the energy went</h2>
        <div id="day-rows">
          {dayCharts.map((title) => (
            <section class="day-row">
              <h3>{title}</h3>
              <div class="day-row-chart" role="img" aria-label={`${title} chart`}></div>
            </section>
          ))}
        </div>
      </section>
    </main>
    <script>
      import "../scripts/dashboard.ts";
    </script>
  </body>
</html>
