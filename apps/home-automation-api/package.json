{
  "name": "home-automation-api",
  "private": true,
  "version": "0.1.0",
  "description": "Fastify API for home automation integrations.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typebox": "^1.0.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
